<Window x:Class="VehicleInspection.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VehicleInspection.App.Views"
        Title="{DynamicResource AppTitle}"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="False">
    <Grid Background="{StaticResource UvssDeepBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ COMPACT TOP BAR ═══ -->
        <Border Grid.Row="0" Background="{StaticResource UvssNavyBrush}" BorderBrush="#24384B" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: compact brand -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" Background="{StaticResource UvssBlueBrush}" BorderBrush="{StaticResource UvssBlueBrightBrush}" BorderThickness="1" CornerRadius="6">
                        <TextBlock Text="UV" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Black" FontSize="14" />
                    </Border>
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource BrandName}" FontWeight="Bold" FontSize="14" />
                        <TextBlock Text="{DynamicResource BrandSubtitle}" Style="{StaticResource MutedText}" FontSize="10" />
                    </StackPanel>
                </StackPanel>

                <!-- Center: nav buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Content="{DynamicResource Dashboard}" Command="{Binding ShowDashboardCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" MinHeight="30" Padding="12,5" ToolTip="Live dashboard — current and previous vehicle scans" />
                    <Button Content="{DynamicResource Reports}" Command="{Binding ShowReportsCommand}" Style="{StaticResource PrimaryButton}" MinHeight="30" Padding="12,5" ToolTip="Search, review, and export inspection records" />
                </StackPanel>

                <!-- Right: compact status + controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,0" MaxWidth="180" ToolTip="TCP device socket connection status">
                        <TextBlock Text="{DynamicResource Socket}" Style="{StaticResource EyebrowText}" FontSize="10" />
                        <TextBlock Text="{Binding SocketStatus}" Foreground="{StaticResource UvssBlueBrightBrush}" TextTrimming="CharacterEllipsis" FontSize="11" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0" ToolTip="{Binding UserName}">
                        <TextBlock Text="{DynamicResource User}" Style="{StaticResource EyebrowText}" FontSize="10" />
                        <TextBlock Text="{Binding UserName}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0" ToolTip="{Binding RoleName}">
                        <TextBlock Text="{DynamicResource Role}" Style="{StaticResource EyebrowText}" FontSize="10" />
                        <TextBlock Text="{Binding RoleName}" FontSize="12" />
                    </StackPanel>
                    <Button Content="{Binding LanguageLabel}" Command="{Binding ToggleLanguageCommand}" Style="{StaticResource PrimaryButton}" MinHeight="30" Padding="10,5" ToolTip="Toggle display language (English / العربية / Melayu / ไทย)" />
                    <Button Content="{DynamicResource Exit}" Command="{Binding ExitCommand}" Style="{StaticResource PrimaryButton}" MinHeight="30" Padding="10,5" Margin="10,0,0,0" ToolTip="Close the application" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ CONTENT AREA ═══ -->
        <Grid Grid.Row="1">
            <views:DashboardView DataContext="{Binding Dashboard}" Visibility="Visible" x:Name="DashboardContent" />
            <views:ReportView DataContext="{Binding Reports}" Visibility="Collapsed" x:Name="ReportContent" />
        </Grid>
    </Grid>
</Window>
