<UserControl x:Class="VehicleInspection.App.Controls.ZoomPanImageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="80">
    <Grid x:Name="Viewport"
          Background="#0A1118"
          ClipToBounds="True"
          Focusable="True"
          MouseWheel="OnMouseWheel"
          MouseLeftButtonDown="OnMouseLeftButtonDown"
          MouseLeftButtonUp="OnMouseLeftButtonUp"
          MouseRightButtonDown="OnMouseRightButtonDown"
          MouseRightButtonUp="OnMouseRightButtonUp"
          MouseMove="OnMouseMove"
          SizeChanged="OnViewportSizeChanged">
        <Canvas x:Name="ImageSurface"
                RenderTransformOrigin="0.5,0.5"
                UseLayoutRounding="True">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="TranslateTransform" X="0" Y="0" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Dynamic background -->
            <Rectangle x:Name="PanelBackground" Width="900" Height="460" Fill="Black" Stroke="#335C84" StrokeThickness="1" />
            <Image x:Name="InspectionImage" Width="900" Height="460" Stretch="Uniform" Visibility="Collapsed" />

            <!-- Placeholder: under-vehicle diagram (hidden by default, shown only when no image) -->
            <Rectangle x:Name="PlaceholderBody" Width="760" Height="120" Canvas.Left="70" Canvas.Top="170" Fill="#142536" Stroke="#315C82" StrokeThickness="1" Visibility="Collapsed" />
            <Line x:Name="PlaceholderBeam" X1="90" X2="810" Y1="230" Y2="230" Stroke="#4EA3E6" StrokeThickness="4" Opacity="0.55" Visibility="Collapsed" />
            <Line x:Name="PlaceholderRail" X1="90" X2="810" Y1="255" Y2="255" Stroke="#274A67" StrokeThickness="2" Opacity="0.8" Visibility="Collapsed" />
            <Rectangle x:Name="PlaceholderModule" Width="220" Height="42" Canvas.Left="340" Canvas.Top="205" Fill="#20384D" Stroke="#4EA3E6" StrokeThickness="1" Opacity="0.9" Visibility="Collapsed" />
            <Ellipse x:Name="PlaceholderWheelLeft" Width="54" Height="54" Canvas.Left="250" Canvas.Top="222" Fill="#0A1118" Stroke="#4EA3E6" StrokeThickness="3" Visibility="Collapsed" />
            <Ellipse x:Name="PlaceholderWheelRight" Width="54" Height="54" Canvas.Left="596" Canvas.Top="222" Fill="#0A1118" Stroke="#4EA3E6" StrokeThickness="3" Visibility="Collapsed" />
            <TextBlock x:Name="PlaceholderTextBlock" Text="{Binding PlaceholderText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Canvas.Left="0" Canvas.Top="0" Width="900" Height="460"
                       TextAlignment="Center" Foreground="#9EACBA" FontSize="18" FontWeight="SemiBold"
                       Padding="0,92,0,0" />

            <!-- FOD overlay rectangles are drawn here from code-behind -->
        </Canvas>

        <!-- License plate badge overlay (click to edit, fixed position) -->
        <TextBox x:Name="LicensePlateBadge"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Bottom"
                 Height="60"
                 Background="#CC0F1720"
                 Foreground="{StaticResource UvssBlueBrightBrush}"
                 CaretBrush="{StaticResource UvssBlueBrightBrush}"
                 FontSize="28" FontWeight="Black" FontFamily="Consolas"
                 TextAlignment="Center"
                 VerticalContentAlignment="Center"
                 BorderThickness="0"
                 Panel.ZIndex="10"
                 GotFocus="LicensePlateBadge_GotFocus"
                 KeyDown="LicensePlateBadge_KeyDown"
                 LostFocus="LicensePlateBadge_LostFocus"
                 Visibility="Collapsed" />

        <!-- Toolbar overlay -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
            <Border Background="#AA101820" Padding="8,4" Margin="0,0,8,0">
                <TextBlock Text="{Binding ElementName=Viewport, Path=Tag}" Foreground="#9EACBA" FontSize="12" />
            </Border>
            <Button Content="{DynamicResource Reset}" Click="OnReset" MinHeight="28" Padding="10,2" />
        </StackPanel>
    </Grid>
</UserControl>
