<UserControl x:Class="VehicleInspection.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VehicleInspection.App.Controls">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.87*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT COLUMN: UVSS CURRENT (top) + PREVIOUS (bottom) ═══ -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <!-- Current UVSS Scan (top) -->
            <Border Grid.Row="0" Style="{StaticResource PanelBorder}" BorderBrush="{StaticResource UvssBlueBrightBrush}" BorderThickness="2" Margin="0,0,0,7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource UvssCurrentScan}" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
                        <!-- ROI sensitivity slider inline in header -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="{DynamicResource Roi}" Style="{StaticResource EyebrowText}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Slider Minimum="1" Maximum="5"
                                    Value="{Binding SensitivityLevel, ElementName=CurrentUvss}"
                                    TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                    Width="120" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SensitivityLevel, ElementName=CurrentUvss, StringFormat=L{0}}"
                                       Foreground="{StaticResource UvssBlueBrightBrush}" FontSize="10" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <Border Grid.Column="2" Background="#1F6FBF" Padding="10,4" CornerRadius="6">
                            <TextBlock Text="{DynamicResource Live}" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </Grid>
                    <controls:ZoomPanImageControl x:Name="CurrentUvss" Grid.Row="1" Margin="0,8,0,0"
                        PlaceholderText="{DynamicResource UvssPlaceholder}"
                        ImagePath="{Binding CurrentUnderVehicleImagePath}"
                        ShowRoiOverlay="True"
                        SyncTarget="{Binding ElementName=PreviousUvss}" />
                </Grid>
            </Border>

            <!-- Previous UVSS Scan (bottom) -->
            <Border Grid.Row="1" Style="{StaticResource PanelBorder}" BorderBrush="#4A6A8A" BorderThickness="1" Margin="0,7,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="{DynamicResource UvssPreviousScan}" Style="{StaticResource EyebrowText}" DockPanel.Dock="Left" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" FontSize="11"
                                   Text="{Binding PreviousInspection.ScanTime, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue=No history}" />
                    </DockPanel>
                    <controls:ZoomPanImageControl x:Name="PreviousUvss" Grid.Row="1" Margin="0,8,0,0"
                        PlaceholderText="{DynamicResource NoPreviousScanPlaceholder}"
                        ImagePath="{Binding PreviousUnderVehicleImagePath}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ RIGHT COLUMN: EVERYTHING ELSE ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- VLPR License Plate Image -->
            <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Margin="0,0,0,7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource VlprPlateImage}" Style="{StaticResource EyebrowText}" />
                    <controls:ZoomPanImageControl Grid.Row="1" Margin="0,6,0,0"
                        PlaceholderText="{DynamicResource VlprPlaceholder}"
                        ImagePath="{Binding LicensePlateImagePath}"
                        LicensePlateOverlay="{Binding CurrentInspection.LicensePlate}"
                        LicensePlateUpdated="VlprImage_LicensePlateUpdated" />
                </Grid>
            </Border>

            <!-- Xray Image -->
            <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,0,0,7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="{DynamicResource XrayImage}" Style="{StaticResource EyebrowText}" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding XrayFodMode}" Style="{StaticResource MutedText}" FontSize="11" DockPanel.Dock="Right" />
                    </DockPanel>
                    <controls:ZoomPanImageControl Grid.Row="1" Margin="0,6,0,0"
                        PlaceholderText="{DynamicResource XrayPlaceholder}"
                        ImagePath="{Binding XrayImagePath}" />
                </Grid>
            </Border>

            <!-- Operator Notes -->
            <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0,0,0,7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource OperatorNotesLabel}" Style="{StaticResource EyebrowText}" Margin="0,0,0,6" />
                    <TextBox Grid.Row="1"
                             Text="{Binding CurrentInspection.Notes, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             MinHeight="28" VerticalScrollBarVisibility="Auto"
                             KeyDown="NotesTextBox_KeyDown"
                             LostFocus="NotesTextBox_LostFocus" />
                </Grid>
            </Border>

            <!-- Compact Status Bar -->
            <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="8,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- FOD + Status tags + System status -->
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{Binding FodSeverityBrush}" Padding="8,3" Margin="0,0,6,0" CornerRadius="6">
                            <TextBlock Text="{Binding FodSummary}" FontSize="11" FontWeight="Bold" Foreground="#101820" />
                        </Border>
                        <ComboBox ItemsSource="{Binding StatusDisplayOptions}"
                                  SelectedItem="{Binding StatusDisplayText}"
                                  Background="{Binding InspectionStatusBrush}"
                                  Foreground="#101820"
                                  FontSize="11" FontWeight="Bold"
                                  Padding="6,2" Margin="0,0,6,0"
                                  MinHeight="26"
                                  BorderThickness="0" />
                        <Border Background="{Binding SystemStatusBrush}" Padding="6,3" CornerRadius="6">
                            <TextBlock Text="{Binding SystemErrorSummary}" FontSize="11" FontWeight="Bold" Foreground="#101820"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                    </StackPanel>
                    <!-- Lane + Scan time -->
                    <DockPanel Grid.Row="1" Margin="0,6,0,0">
                        <TextBlock Text="{Binding CurrentInspection.ScanTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                   Style="{StaticResource MutedText}" FontSize="11" DockPanel.Dock="Right" />
                        <TextBlock Text="{Binding CurrentInspection.Lane, StringFormat=Lane: {0}}"
                                   Style="{StaticResource MutedText}" FontSize="11" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
