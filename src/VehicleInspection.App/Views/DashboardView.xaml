<UserControl x:Class="VehicleInspection.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VehicleInspection.App.Controls">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="2.2*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.25*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource PanelBorder}" BorderBrush="{StaticResource UvssBlueBrightBrush}" BorderThickness="2" Margin="0,0,14,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="{DynamicResource UnderVehicleImage}" Style="{StaticResource EyebrowText}" DockPanel.Dock="Left" />
                    <Border DockPanel.Dock="Right" Background="#1F6FBF" Padding="10,4">
                        <TextBlock Text="PRIMARY DISPLAY" FontSize="11" FontWeight="Bold" />
                    </Border>
                </DockPanel>
                <controls:ZoomPanImageControl Grid.Row="1" PlaceholderText="UV undervehicle scan - zoom wheel / drag pan" ImagePath="{Binding CurrentInspection.UnderVehicleImagePath}" />
                <TextBlock Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource MutedText}" Text="High-priority undercarriage review. This panel intentionally dominates the dashboard for 24/7 security operations." />
            </Grid>
        </Border>

        <UniformGrid Grid.Row="0" Grid.Column="1" Rows="3" Margin="0,0,0,14">
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource FullVehicleImage}" Style="{StaticResource EyebrowText}" />
                    <controls:ZoomPanImageControl Grid.Row="1" PlaceholderText="Full vehicle image" Margin="0,10,0,0" />
                </Grid>
            </Border>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource LicensePlateImage}" Style="{StaticResource EyebrowText}" />
                    <controls:ZoomPanImageControl Grid.Row="1" PlaceholderText="OCR plate crop" ImagePath="{Binding CurrentInspection.LicensePlateImagePath}" Margin="0,10,0,0" />
                </Grid>
            </Border>
            <Border Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource XrayFod}" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="  |  " Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding XrayFodMode}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <controls:ZoomPanImageControl PlaceholderText="X-ray image if provided; otherwise FOD map" ImagePath="{Binding CurrentInspection.XrayImagePath}" />
                        <ItemsControl ItemsSource="{Binding CurrentInspection.FodAlerts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#D64A36" Padding="8,4" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Description}" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.35*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource InspectionSummary}" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="{Binding CurrentInspection.LicensePlate, StringFormat=Plate: {0}}" Margin="0,12,0,4" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="{Binding CurrentInspection.Lane}" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding CurrentInspection.HighestFodSeverity, StringFormat=FOD severity: {0}}" Margin="0,8,0,0" Foreground="{StaticResource UvssWarningBrush}" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="0,0,14,0" BorderBrush="#E35D5B" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="{DynamicResource SystemStatus}" Style="{StaticResource EyebrowText}" DockPanel.Dock="Left" />
                        <Border DockPanel.Dock="Right" Background="#E35D5B" Padding="8,3">
                            <TextBlock Text="{Binding CriticalErrorCount, StringFormat=CRITICAL {0}}" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding SystemErrorSummary}" Margin="0,10,0,8" FontSize="16" Foreground="{Binding SystemStatusBrush}" FontWeight="Bold" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="112">
                        <ItemsControl ItemsSource="{Binding SystemErrors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#351C22" BorderBrush="#E35D5B" BorderThickness="1" Padding="8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="{StaticResource UvssTextBrush}" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding Severity}" Foreground="{StaticResource UvssWarningBrush}" FontWeight="Bold" DockPanel.Dock="Right" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Message}" Margin="0,4,0,0" Foreground="{StaticResource UvssTextBrush}" />
                                            <TextBlock Text="{Binding OperatorAction}" Margin="0,3,0,0" Style="{StaticResource MutedText}" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource OperatorNotes}" Style="{StaticResource EyebrowText}" />
                    <TextBox Text="{Binding CurrentInspection.Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0" MinHeight="92" TextWrapping="Wrap" AcceptsReturn="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
